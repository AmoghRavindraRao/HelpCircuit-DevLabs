# HelpCircuit LLM configuration.
# Copy this file to ".env" (same folder) and fill in ONE provider's key.
# If no key is set, the agents fall back to deterministic decisions and the app
# still runs fully.

# --- Option A: OpenAI (or any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
# Optional: point at a compatible endpoint (Groq, Together, local, etc.)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Option B: Anthropic ---
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-3-5-haiku-latest

# --- Optional overrides ---
# LLM_PROVIDER=auto      # auto | openai | anthropic | none
# LLM_TIMEOUT=30

# --- Discord bot ---
# Create a bot at https://discord.com/developers/applications and paste the token.
# Invite it with the "bot" and "applications.commands" scopes.
DISCORD_BOT_TOKEN=
# Strongly recommended: your server (guild) id, so slash commands appear INSTANTLY.
# Without it, global commands are used and can take up to ~1 hour to show up.
# DISCORD_GUILD_ID=
